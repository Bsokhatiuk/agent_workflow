# Copy to .env for local development (the server scripts load it if present).
BOT_TOKEN=123456:replace-with-botfather-token
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token; pass the same value to setWebhook.
BOT_WEBHOOK_SECRET=replace-with-random-secret
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
# Public HTTPS URL of the Mini App (a tunnel in local development).
WEBAPP_URL=https://example.com
PORT=3000
